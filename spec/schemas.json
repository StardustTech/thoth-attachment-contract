{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neutral-attachment.invalid/schema/0.2.0",
  "title": "Neutral Attachment v0",
  "x-spdx-license-identifier": "Apache-2.0",
  "$defs": {
    "TenantCreate": {
      "type": "object",
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "epoch"
      ],
      "additionalProperties": false
    },
    "Tenant": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "ACTIVE",
            "FROZEN",
            "CLOSED"
          ]
        }
      },
      "required": [
        "tenant_id",
        "epoch",
        "state"
      ],
      "additionalProperties": true
    },
    "Begin": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\r\\n]+/[^\\r\\n]+$"
        },
        "byte_length": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 67108864
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "resource_id",
        "media_type",
        "byte_length",
        "sha256"
      ],
      "additionalProperties": false
    },
    "PartRef": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "number",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Complete": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/PartRef"
          }
        }
      },
      "required": [
        "parts"
      ],
      "additionalProperties": false
    },
    "Resource": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "resource_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "state": {
          "enum": [
            "UPLOADING",
            "READY",
            "DELETED"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string"
        },
        "byte_length": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "modified_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "tenant_id",
        "resource_id",
        "state",
        "revision",
        "media_type",
        "byte_length",
        "sha256",
        "modified_at"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "READY"
              }
            }
          },
          "then": {
            "properties": {
              "byte_length": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "Session": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "upload_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "resource_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "state": {
          "enum": [
            "OPEN",
            "COMPLETED",
            "ABORTED",
            "EXPIRED"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "part_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "tenant_id",
        "upload_id",
        "resource_id",
        "state",
        "expires_at",
        "part_count"
      ],
      "additionalProperties": true
    },
    "Part": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "number",
        "sha256",
        "byte_length"
      ],
      "additionalProperties": true
    },
    "ResourceList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          }
        },
        "next_after": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "next_after"
      ],
      "additionalProperties": true
    },
    "Usage": {
      "type": "object",
      "properties": {
        "ready_count": {
          "type": "integer",
          "minimum": 0
        },
        "ready_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "open_uploads": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ready_count",
        "ready_bytes",
        "open_uploads"
      ],
      "additionalProperties": true
    },
    "Operation": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "state": {
          "const": "SUCCEEDED"
        },
        "status": {
          "const": 200
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/Tenant"
            },
            {
              "$ref": "#/$defs/Resource"
            },
            {
              "$ref": "#/$defs/Session"
            },
            {
              "$ref": "#/$defs/Part"
            }
          ]
        },
        "request_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "operation_id",
        "state",
        "status",
        "result",
        "request_fingerprint"
      ],
      "additionalProperties": true
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "unauthenticated",
            "denied",
            "missing",
            "invalid",
            "conflict",
            "unsupported",
            "unavailable",
            "integrity_error"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": true
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "0.2.0"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_resource_bytes": {
          "type": "integer"
        },
        "max_part_bytes": {
          "type": "integer"
        },
        "max_parts": {
          "type": "integer"
        },
        "authorization_profile": {
          "const": "trusted-service-bearer"
        }
      },
      "required": [
        "contract_version",
        "features",
        "max_resource_bytes",
        "max_part_bytes",
        "max_parts",
        "authorization_profile"
      ],
      "additionalProperties": true
    },
    "ExportBlob": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "sha256",
        "byte_length"
      ],
      "additionalProperties": true
    },
    "ExportSession": {
      "type": "object",
      "properties": {
        "session": {
          "$ref": "#/$defs/Session"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          }
        }
      },
      "required": [
        "session",
        "parts"
      ],
      "additionalProperties": true
    },
    "Export": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "0.2.0"
        },
        "tenant": {
          "$ref": "#/$defs/Tenant"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          }
        },
        "uploads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExportSession"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Operation"
          }
        },
        "blobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExportBlob"
          }
        }
      },
      "required": [
        "contract_version",
        "tenant",
        "resources",
        "uploads",
        "operations",
        "blobs"
      ],
      "additionalProperties": true
    }
  }
}
